{
  "name": "@pitstop/demo-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "quote": "tsx --env-file-if-exists=../../.env src/quote.ts",
    "key": "tsx --env-file-if-exists=../../.env src/key.ts",
    "keystatus": "tsx --env-file-if-exists=../../.env src/keystatus.ts",
    "spend": "tsx --env-file-if-exists=../../.env src/spend.ts"
  },
  "dependencies": {
    "@pitstop/sdk": "workspace:*",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
