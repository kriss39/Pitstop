{
  "name": "pitstop",
  "private": true,
  "description": "Refuel your AI agents from any chain, and keep them on a leash.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @pitstop/web dev",
    "dev:api": "pnpm --filter @pitstop/api dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
