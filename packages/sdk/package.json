{
  "name": "@getpitstop/sdk",
  "version": "0.1.1",
  "description": "Refuel AI agents on Tempo from any chain, and cap what they can spend.",
  "license": "MIT",
  "keywords": [
    "tempo",
    "mpp",
    "ai-agents",
    "account-keychain",
    "spending-limit",
    "lifi",
    "stablecoin",
    "agent-wallet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kriss39/pitstop.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://fuel.pitstopgas.workers.dev",
  "bugs": "https://github.com/kriss39/pitstop/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "^2.57.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
